# Where this file is used
#   * Production / server:  cp .env.example deploy/.env   (git-ignored)
#                           docker compose -f deploy/compose.yaml up -d
#     Docker Compose reads deploy/.env automatically.
#   * Local development:    no .env needed. Start the database with
#                           `docker compose up -d`, then run
#                           `mvn spring-boot:run -Dspring-boot.run.profiles=demo`.
#     Every variable below has a working default. Spring Boot does NOT read
#     .env files itself, so if you do want overrides locally, export them in
#     your shell or set them in your IDE run configuration.


# -----------------------------------------------------------------------------
# REQUIRED for deploy/compose.yaml (Compose refuses to start while empty)
# -----------------------------------------------------------------------------

# Published container image to run (built by .github/workflows/cd.yml).
# Example: ghcr.io/<owner>/oss-portal:latest
IMAGE=

# HMAC key used to sign login tokens (HS256).
# Must be at least 32 bytes or the app fails at startup.
# Generate one with:  openssl rand -base64 48
# Do not leave it unset outside Compose: the app then silently falls back to
# a publicly known dev secret from application.yml.
JWT_SECRET=


# -----------------------------------------------------------------------------
# Strongly recommended for deploy
# -----------------------------------------------------------------------------

# Public address of the site. Used to build the links that appear inside
# announcements sent to WhatsApp/Telegram. Set it to your real URL,
# e.g. https://oss.example.com (no trailing slash).
PUBLIC_BASE_URL=http://localhost:8080

# Password of the PostgreSQL user "oss". Used by both the app and the database
# container. Default: oss
# NOTE: Postgres only applies this on first initialisation of the data volume.
# Changing it later does not change the password of an existing database.
# DB_PASSWORD=oss

# First administrator, created on startup if no account with this email exists.
# Leave both empty to skip. The password must be at least 8 characters.
# Remove or blank these once you have logged in.
ADMIN_EMAIL=
ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# Host port that maps to the app (deploy/compose.yaml only). Default: 8080
# HTTP_PORT=8080

# Spring profile(s). "demo" fills an EMPTY database with sample bodies, members,
# meetings and petitions, and creates accounts with the well-known password
# demo12345 (admin@ukma.edu.ua, sk.1@ukma.edu.ua, ...).
# NEVER enable it on a public server. Default: none
# SPRING_PROFILES_ACTIVE=demo


# -----------------------------------------------------------------------------
# Only when running the app OUTSIDE deploy/compose.yaml
# (mvn spring-boot:run, java -jar, your own compose file)
# deploy/compose.yaml hardcodes DB_URL, DB_USER and STORAGE_PATH, so setting
# them in deploy/.env has no effect.
# -----------------------------------------------------------------------------

# JDBC URL of PostgreSQL. The default matches the root compose.yaml (port 5433).
# DB_URL=jdbc:postgresql://localhost:5433/oss

# Database user. The default matches the root compose.yaml.
# DB_USER=oss

# Directory where protocol documents are stored.
# Default: ./storage locally. The Docker image sets /data/storage, which is the
# mounted oss-files volume, so do not change it in containers.
# STORAGE_PATH=storage


# -----------------------------------------------------------------------------
# Advanced tuning (not passed through deploy/compose.yaml)
# Any application.yml key can be overridden as an env var (dots and dashes
# become underscores, upper-case). These only take effect if you add them to
# the app's `environment:` block in your own compose file or set them in the
# shell. Defaults shown.
# -----------------------------------------------------------------------------

# Login token lifetime.
# OSS_SECURITY_TOKEN_TTL=8h

# Outbox attempts before a notification is marked failed.
# OSS_NOTIFICATION_MAX_ATTEMPTS=5

# Back-to-back send retries inside a single attempt.
# OSS_NOTIFICATION_IMMEDIATE_RETRIES=2

# Delay before the second attempt; doubles with each further one.
# OSS_NOTIFICATION_BACKOFF=30s

# How often the outbox is polled for pending notifications.
# OSS_NOTIFICATION_POLL_INTERVAL=10s

# How often upcoming meetings are checked for reminders.
# OSS_NOTIFICATION_REMINDER_INTERVAL=1m
